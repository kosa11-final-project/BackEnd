# This file is a template. On EC2, render the real values from Parameter Store
# into /opt/stockit/config/app.env with mode 0600. Never commit that file.

TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Seoul

# Oracle Database Free is installed directly on the Application EC2 host.
DB_URL=jdbc:oracle:thin:@host.docker.internal:1521/FREEPDB1
DB_USERNAME=STOCKIT
DB_PASSWORD=CHANGE_ME
FLYWAY_ENABLED=false

REDIS_USERNAME=
REDIS_PASSWORD=CHANGE_ME
REDIS_CONNECT_TIMEOUT=3s
REDIS_COMMAND_TIMEOUT=3s

RABBITMQ_USERNAME=stockit
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/

APP_CORS_ALLOWED_ORIGINS=https://stockfit.win,https://www.stockfit.win
SESSION_COOKIE_SECURE=true

STOCKIT_INTERNAL_API_KEY=
STOCKIT_INTERNAL_API_USER_ID=0
STOCKIT_INTERNAL_API_PRINCIPAL=ml-service

INVENTORY_SYNC_BATCH_ENABLED=true
INVENTORY_SYNC_DEMO_ENABLED=false
INVENTORY_SYNC_SCHEDULE_ENABLED=true
INVENTORY_SYNC_SCHEDULE_CRON=0 30 0 * * *
INVENTORY_SYNC_SCHEDULE_ZONE=Asia/Seoul

STRATEGY_STATISTICS_SCHEDULE_ENABLED=true
STRATEGY_STATISTICS_SCHEDULE_CRON=0 0 4 * * *
STRATEGY_STATISTICS_SCHEDULE_ZONE=Asia/Seoul
STATISTICS_DEMO_BACKFILL_ENABLED=false
STATISTICS_DEMO_BACKFILL_RUN_ON_STARTUP=false
STATISTICS_STRATEGY_DEMO_BACKFILL_ENABLED=false
STATISTICS_STRATEGY_DEMO_BACKFILL_RUN_ON_STARTUP=false

# AI/ML integration remains disabled until the deployment owner receives the keys.
SALES_DAILY_EXPORT_DESTINATION=LOCAL
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_BLOB_PREFIX=sales-daily
DEMAND_FORECAST_ORCHESTRATION_ENABLED=false
DEMAND_FORECAST_DAILY_IMPORT_PATH=/api/v1/demand-forecasts/jobs/{azureJobId}/daily-import
DEMAND_FORECAST_FASTAPI_BASE_URL=
DEMAND_FORECAST_FASTAPI_KEY=
DEMAND_FORECAST_JOB_TIMEOUT=4h
AI_STRATEGY_MESSAGING_ENABLED=false
ML_FORECAST_BASE_URL=
