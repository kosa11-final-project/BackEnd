INCIDENT_PROMETHEUS_BASE_URL=http://prometheus:9090
INCIDENT_LOG_LOOKBACK=5m
INCIDENT_COOLDOWN=15m
INCIDENT_HTTP_TIMEOUT=15
INCIDENT_MAX_LOG_LINES=120
INCIDENT_ENVIRONMENT=production
