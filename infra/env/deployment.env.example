# Non-secret deployment state. The deploy scripts update the slot image tags.
BACKEND_IMAGE_REPOSITORY=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/stockfit-backend
BACKEND_BLUE_IMAGE_TAG=bootstrap
BACKEND_GREEN_IMAGE_TAG=bootstrap
APP_ENV_FILE=/opt/stockit/config/app.env

# Paths used on the Application EC2 instance.
STOCKFIT_HOME=/opt/stockit
COMPOSE_FILE=/opt/stockit/infra/compose/compose.prod.yml
NGINX_UPSTREAM_DIR=/etc/nginx/stockit
ACTIVE_SLOT_FILE=/opt/stockit/runtime/active-slot
